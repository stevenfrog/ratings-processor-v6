// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserChallenge {
  userId             BigInt
  challengeId        String
  attended           String?
  placed             Int?
  old_rating         Int?
  old_vol            Int?
  system_point_total Float?
  point_total        Float?
  rated_ind          Int?

  @@id([userId, challengeId])
  @@map("user_challenges")
}

model Submission {
  id               String    @id @default(cuid())
  challengeId      String
  userId           BigInt
  score            Float?
  initialScore     Float?
  submissionTime   DateTime  @default(now())
  submissionNumber Int
  example          Int
  openTime         DateTime
  languageId       Int

  @@map("submissions")
}

model RatingHistory {
  id          Int       @id @default(autoincrement())
  userId      BigInt
  challengeId String
  rating      Int
  vol         Int
  createdAt   DateTime  @default(now())

  @@map("rating_history")
}

model ReviewType {
  id       String  @id
  name     String
  isActive Boolean
}
